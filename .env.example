# --- database ---------------------------------------------------------
POSTGRES_USER=zta
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=zta
DATABASE_URL=postgresql+psycopg://zta:change_me_postgres@postgres:5432/zta

# --- redis ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# --- tokens -----------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Shared between the gateway, the PDP endpoint and the internal services.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SIGNING_KEY=replace-with-another-long-random-value

# --- gateway ----------------------------------------------------------
CONTROL_PLANE_URL=http://control-plane:8000
DECISION_CACHE_SECONDS=5
PDP_TIMEOUT_SECONDS=3

# --- hardening --------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS=240
LOGIN_RATE_LIMIT_REQUESTS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- bootstrap --------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SEED_DEMO_DATA=true

# --- frontend ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_GATEWAY_URL=http://localhost:8080
